<?xml version="1.0" encoding="utf-8"?>
<!-- The system splash masks the icon down to the inner ~2/3 of its canvas, and
     ic_main_logo fills almost its whole 671x671 viewport. The inset keeps the
     artwork inside the safe zone instead of getting clipped. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_main_logo"
    android:inset="22.3%" />
