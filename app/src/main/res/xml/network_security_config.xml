<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Dev backend has no TLS yet; scope cleartext to the dev hosts, not app-wide.
         10.0.2.2 is the emulator's alias for the host machine (the wt.baseUrl default). -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.0.154</domain>
    </domain-config>
</network-security-config>
